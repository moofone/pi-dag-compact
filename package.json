{
	"name": "pi-dag-compact",
	"version": "0.2.0",
	"description": "Pi extension for bounded working memory and durable research evidence, with a scripted classic-compaction evaluation harness.",
	"author": "Greg Tiller",
	"license": "MIT",
	"type": "module",
	"private": false,
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moofone/pi-dag-compact.git"
	},
	"homepage": "https://github.com/moofone/pi-dag-compact#readme",
	"bugs": {
		"url": "https://github.com/moofone/pi-dag-compact/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"compaction",
		"working-memory",
		"evaluation"
	],
	"files": [
		"src",
		"fixtures",
		"docs",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"SECURITY.md"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
		"test:integration": "node --experimental-strip-types --test --test-timeout=120000 test/integration/*.test.ts",
		"eval:classic": "node --experimental-strip-types src/eval/run-classic.ts",
		"pack:dry": "npm pack --dry-run",
		"check": "npm run typecheck && npm run lint && npm test && npm run pack:dry"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-agent-core": "0.85.1",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "24.13.3",
		"typebox": "1.3.7",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"graphology": "0.26.0",
		"graphology-dag": "0.4.1"
	}
}
